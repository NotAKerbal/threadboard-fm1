{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true, "lib": ["ES2024", "DOM"], "types": ["node"]
  },
  "include": ["bridge/**/*.ts", "tests/**/*.ts"]
}
